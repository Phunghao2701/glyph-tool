# Replace with a long random secret before starting the container.
# Keep this value unchanged to unlock the persisted provider keyring after restarts.
VFK_KEYRING_PASSWORD=replace-with-a-long-random-secret

# Host ports published on 127.0.0.1.
VFK_HTTP_PORT=8000
VFK_OAUTH_CALLBACK_PORT=8765

# Google Picker (public browser config; restrict the API key to your origins and APIs).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
